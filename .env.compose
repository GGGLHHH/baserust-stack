# compose 变量默认值(被 compose.yaml 的 include 读取)。全部注释 = 用 baserust/docker-compose.yml 里的默认值。
# 要改端口/凭据:直接改这里(取消注释),或临时用同名环境变量覆盖(环境变量优先)。
# 注意:后端各服务的 ${VAR} 只从本文件取,不读 baserust/.env —— 那份是给本机 just dev 用的。

# NGINX_PORT=80
# APP_PORT=6453
# IDM_PORT=6454
# PG_PORT=5821
# MINIO_PORT=9862
# MINIO_CONSOLE_PORT=9863
# NATS_PORT=2224
# DBHUB_PORT=3777

# 多租户账号拆分(app / content / search 各拆 owner / system,见 baserust/scripts/initdb/10-tenancy-roles.sh)。
# 默认账号 <schema>_owner / <schema>_system、密码 pwd。老的数据卷(多租户之前建的)先在本目录 just db-ensure-roles
# (补 role + 拆账号,打本栈的 pg 容器),再 just infra --build 重跑迁移。
# APP_DB_OWNER_PASSWORD=pwd
# APP_DB_SYSTEM_PASSWORD=pwd
# CONTENT_DB_OWNER_PASSWORD=pwd
# CONTENT_DB_SYSTEM_PASSWORD=pwd
# SEARCH_DB_OWNER_PASSWORD=pwd
# SEARCH_DB_SYSTEM_PASSWORD=pwd
